PORT=8788
DATA_DIR=/opt/dacheng-ai/data
SQLITE_PATH=/opt/dacheng-ai/data/dacheng-ai.sqlite

DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_COMPLETION_TOKENS=1400
# Bot Father receives a larger signed Responses-adapter budget so generated
# HTML/CSS/JS is not truncated before the closing document tags.
BOT_FATHER_MAX_COMPLETION_TOKENS=6000

# Prefer LibreChat Agents API as the app chat backend when these are configured.
ENABLE_LIBRECHAT_AGENT_CHAT=false
LIBRECHAT_AGENTS_BASE_URL=http://127.0.0.1:3080/api/agents/v1
LIBRECHAT_AGENT_API_KEY=REPLACE_WITH_LIBRECHAT_AGENT_API_KEY
LIBRECHAT_AGENT_ID=agent_xxx

FABUSHI_API_BASE_URL=https://api.ombhrum.com
CBETA_API_ROOT=https://api.ombhrum.com/api/cbeta
MEMBER_MONTHLY_TOKEN_LIMIT=1000000
FREE_MONTHLY_TOKEN_LIMIT=1000
REQUIRE_MEMBER_FOR_AI=false
# Optional private smoke-test account token. Generate a unique secret per
# environment; the server intentionally has no source-code default.
# TEST_ACCOUNT_TOKEN=

CORS_ORIGIN=*
RATE_LIMIT_PER_MINUTE=90
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
ENABLE_CODEX_SDK=false
# Enables Codex SDK chat orchestration over the DeepSeek-compatible Responses adapter.
ENABLE_CODEX_SDK_CHAT=true

# OpenClaw Agent Gateway bridge. Keep disabled until the self-hosted gateway is ready.
ENABLE_OPENCLAW_AGENT_CHAT=false
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_OPENCLAW_GATEWAY_TOKEN
OPENCLAW_AGENT_ID=fabushi-public-agent
# Optional full HTTP endpoint override for Gateway run creation.
OPENCLAW_RUNS_ENDPOINT=
