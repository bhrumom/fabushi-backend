[Unit]
Description=Dacheng AI Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/dacheng-ai/current
EnvironmentFile=/opt/dacheng-ai/.env
ExecStart=/usr/bin/node src/secure-entry.js
Restart=always
RestartSec=5
User=dacheng-ai
Group=dacheng-ai
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/dacheng-ai

[Install]
WantedBy=multi-user.target
