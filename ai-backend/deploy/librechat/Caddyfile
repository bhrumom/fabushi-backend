	encode zstd gzip

	@ai_bridge path /api/ai* /api/resources* /codex-deepseek* /health
	reverse_proxy @ai_bridge 127.0.0.1:8788 {
		flush_interval -1
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	reverse_proxy 127.0.0.1:3080 {
		flush_interval -1
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
