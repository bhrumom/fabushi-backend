# Fabushi FDN enrollment service environment.
# Install as /etc/fabushi/fdn-network-enrollment.env with mode 0600.
# Never commit real values.

FABUSHI_PLATFORM_CORE_URL=https://platform-core.internal.example
FDN_NETWORK_AUTHORITY_TOKEN=REPLACE_WITH_NETWORK_AUTHORITY_SECRET_AT_LEAST_48_CHARS
FABUSHI_FDN_CELL_ID=cell-fdn-REPLACE_OPAQUE_ACCOUNT_CELL
FABUSHI_FDN_ENROLLMENT_BROKER_TOKEN=REPLACE_WITH_DISTINCT_BROKER_SECRET_AT_LEAST_48_CHARS
FABUSHI_FDN_ENROLLMENT_STATE_KEY_B64=REPLACE_WITH_32_BYTE_BASE64_KEY
FABUSHI_FDN_ENROLLMENT_LISTEN_HOST=127.0.0.1
FABUSHI_FDN_ENROLLMENT_PORT=8793
FABUSHI_FDN_STATE_ROOT=/var/lib/fabushi-fdn
FABUSHI_FDN_ENROLLMENT_STATE_PATH=/var/lib/fabushi-fdn/enrollment-state.json

# Required security boundary: dedicated rootless Docker daemon for this
# coordinator account. The launcher rejects the rootful system Docker socket.
DOCKER_HOST=unix:///run/user/REPLACE_UID/docker.sock

# Official MCP controller ingress projection. The controller worker remains a
# separate loopback-only tsnet transport process; only this coordinator owner
# receives FDN_NETWORK_AUTHORITY_TOKEN.
FABUSHI_FDN_CONTROLLER_WORKER_URL=http://127.0.0.1:8791
FABUSHI_FDN_INGRESS_USER_ID=user-REPLACE_IMMUTABLE_FABUSHI_SUBJECT
FABUSHI_FDN_INGRESS_STATE_FILE=/var/lib/fabushi-fdn/official-device-mcp-ingress.json
